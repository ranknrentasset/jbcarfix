{#- Lead form for one tenant workshop (w). Never shown for trial workshops. -#}
{%- set s = site.strings[entry.lang] -%}
{%- set isArea = entry.type == "area" -%}
{%- set areaName = areas[entry.key].name[entry.lang] if isArea else site.region -%}
{%- set thanksUrl = site.thanks[entry.lang] -%}
  <form class="lead" action="https://api.web3forms.com/submit" method="post" data-lead-form data-thanks="{{ thanksUrl }}" data-error="{{ s.formError }}" data-invalid="{{ s.formInvalid }}" data-sending="{{ s.formSending }}">
    <h3>{{ s.formHeading }}</h3>
    <input type="hidden" name="access_key" value="{{ w.web3forms_key }}">
    <input type="hidden" name="subject" value="New lead: {{ areaName }} ({{ entry.key }}, {{ entry.lang }}) via {{ brand }}">
    <input type="hidden" name="from_name" value="{{ brand }} website">
    <input type="hidden" name="workshop_id" value="{{ w.workshop_id }}">
    <input type="hidden" name="routed_to" value="{{ w.workshop.name }}">
    <input type="hidden" name="redirect" value="{{ thanksUrl | absUrl(site) }}">
    <input type="hidden" name="lang" value="{{ entry.lang }}">
    <input type="hidden" name="page" value="{{ entry.url }}">
    <input type="hidden" name="utm_source" value="">
    <input type="hidden" name="utm_medium" value="">
    <input type="hidden" name="utm_campaign" value="">
    <input type="hidden" name="utm_term" value="">
    <input type="hidden" name="utm_content" value="">
    <div class="hp" aria-hidden="true">
      <label>Leave empty <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off"></label>
    </div>
    <label>{{ s.formName }}
      <input type="text" name="name" required minlength="2" maxlength="80" autocomplete="name">
    </label>
    <label>{{ s.formPhone }}
      <input type="tel" name="phone" required minlength="9" maxlength="20" pattern="\+?[0-9][0-9 \(\)\-]{7,18}[0-9]" autocomplete="tel" inputmode="tel" placeholder="{{ s.formPhoneHint }}">
    </label>
{%- if isArea %}
    <input type="hidden" name="area" value="{{ entry.key }}">
{%- else %}
    <label>{{ s.formArea }}
      <select name="area" required>
        {%- for k in site.areaOrder %}
        <option value="{{ k }}">{{ areas[k].name[entry.lang] }}</option>
        {%- endfor %}
        <option value="other" selected>{{ s.formOther }}</option>
      </select>
    </label>
{%- endif %}
    <label>{{ s.formService }}
      <select name="service" required>
        {%- for k in site.serviceOrder %}
        <option value="{{ k }}"{% if entry.type == "service" and entry.key == k %} selected{% endif %}>{{ services[k].name[entry.lang] }}</option>
        {%- endfor %}
        <option value="other"{% if entry.type != "service" %} selected{% endif %}>{{ s.formOther }}</option>
      </select>
    </label>
    <label>{{ s.formMessage }}
      <textarea name="message" rows="3" maxlength="1000"></textarea>
    </label>
    <label class="check"><input type="checkbox" name="consent" value="yes" required> <span>{{ s.formConsent }} <a href="{{ site.privacy[entry.lang] }}">{{ s.privacyLabel }}</a></span></label>
    <button type="submit" class="btn">{{ s.formSubmit }}</button>
    <p class="status" role="status" aria-live="polite"></p>
  </form>
