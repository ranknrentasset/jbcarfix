{%- set s = site.strings[entry.lang] -%}
{%- set list = entry.workshops | resolveWorkshops(routing) -%}
{#- No workshop listed: no contact box at all (no buttons, no "coming soon" hints). #}
{%- if list.length %}
{%- set hasTenant = list | byStatus("tenant") | length %}
<section class="contact" id="contact">
  <h2>{{ s.contactHeading }}</h2>
  {#- Shared intro, once per page. All-trial pages get the full plural intro; a page with any
      tenant card gets only the first two sentences, and each card carries its own line. #}
  <p class="ws-intro">{{ disclosures.trialIntro.lead[entry.lang] | fill }}{% if not hasTenant %} {{ disclosures.trialIntro.trialClaims[entry.lang] | fill }}{% endif %}</p>
{#- Workshop names and numbers appear only in these visible cards, never in JSON-LD or meta tags.
    Each card carries its own analytics parameters (data-ev-*), read by site.js. #}
  <div class="ws-list">
  {%- for w in list %}
  <article class="ws-card" data-ev-area="{{ entry.eventArea }}" data-ev-lang="{{ entry.lang }}" data-ev-workshop-id="{{ w.workshop_id }}" data-ev-tenant-status="{{ w.tenant_status }}" data-ev-service="{{ entry.eventService }}" data-ev-page-path="{{ entry.url }}">
    {%- if w.tenant_status == "tenant" and w.workshop.logo %}
    <img class="ws-logo" src="{{ w.workshop.logo }}" alt="{{ w.workshop.name }}" width="120" height="60">
    {%- endif %}
    <h3>{{ w.workshop.name }}</h3>
    <p class="coverage">{{ w.workshop.coverage[entry.lang] }}</p>
    {%- if w.services %}
    <p class="ws-services">{{ s.servicesOnlyLabel }}: {% for k in w.services %}{{ s.generalService if k == "general" else services[k].name[entry.lang] }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
    {%- endif %}
    <details class="hours">
      <summary>{{ s.hoursLabel }}</summary>
      <dl>
      {%- for d in w.hours[entry.lang] %}
        <dt>{{ d.day }}</dt><dd>{{ d.text }}</dd>
      {%- endfor %}
      </dl>
    </details>
    <p class="cta">
      <a class="btn" href="tel:{{ w.phone }}" data-ev="click_call">{{ s.callLabel }} {{ w.phone_display or w.phone }}</a>
      {%- if w.phone_label %}
      <span class="phone-label">({{ w.phone_label }})</span>
      {%- endif %}
      {%- if w.whatsapp %}
      <a class="btn btn-wa" href="{{ w | waLink(i18n.whatsappText[entry.lang], entry.key, entry.lang, routing) }}" rel="noopener" data-ev="click_whatsapp">{{ w.whatsapp_label or s.whatsappLabel }}</a>
      {%- endif %}
    </p>
    {%- if hasTenant %}
    <p class="ws-disclosure">{{ (disclosures.tenantCard if w.tenant_status == "tenant" else disclosures.trialCard)[entry.lang] | fill({ workshop: w.workshop }) }}</p>
    {%- endif %}
    {%- if w.tenant_status == "tenant" and w.web3forms_key %}
    {% include "partials/lead-form.njk" %}
    {%- endif %}
  </article>
  {%- endfor %}
  </div>
  {%- if list | withWhatsapp | length %}
  <p class="note">{{ i18n | underButtonNote(entry.lang) }}</p>
  {%- endif %}
</section>
{%- endif %}
