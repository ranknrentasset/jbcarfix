{%- if entry.content.faqs and entry.content.faqs.length %}
<section class="sec faqs">
  <h2>{{ site.strings[entry.lang].faqHeading }}</h2>
  <div class="faq-list">
  {%- for f in entry.content.faqs %}
  <details>
    <summary>{{ f.q }}</summary>
    <p>{{ f.a | linkify | safe }}</p>
  </details>
  {%- endfor %}
  </div>
</section>
{%- endif %}
